# WebODM Connection Settings
WEBODM_URL=
WEBODM_USERNAME=
WEBODM_PASSWORD=
WEBODM_NODE_ID=

# Paths (quote Windows paths to be safe)
SURVEYS_ROOT=
# One root:
FIELD_DATA_ROOT=Y:/field-data/2026/sorted

# Multiple roots (comma-separated):
# FIELD_DATA_ROOT=Y:/field-data/2026/sorted, Z:/field-data-2026/sorted 

UPLOAD_CACHE_ROOT=
WEBODM_UPLOAD_CACHE_ROOT=

# Cross-run filter
CROSSRUN_MAX_GAP=10
CROSSRUN_WINDOW=3
DELETE_RAW=true # delete raw file is set to true

# Naming defaults (these match your config.py keys)
CROSSRUN_MODE=xc
TASK1_BOUNDARY_MODE=xb
TASK2_BOUNDARY_MODE=b
TASK4_BOUNDARY_MODE=b

# WebODM options as JSON (no spaces, valid JSON)
WEBODM_TASK1_OPTIONS_JSON={"auto-boundary":true,"fast-orthophoto":true,"mesh-size":300000,"min-num-features":20000,"orthophoto-resolution":1,"pc-quality":"high","skip-3dmodel":true} 
WEBODM_TASK2_OPTIONS_JSON={"dem-resolution":1,"dsm":true,"dtm":true,"mesh-size":300000,"min-num-features":20000,"orthophoto-resolution":1,"pc-quality":"high"}                
WEBODM_TASK4_OPTIONS_JSON={"fast-orthophoto":true,"mesh-size":300000,"min-num-features":20000,"orthophoto-resolution":1,"pc-quality":"high","skip-3dmodel":true}


WEBODM_PRIMARY_TASK=task2
WEBODM_FALLBACK_TASK=task4

# Exports master switch
EXPORTS_ENABLED=true

# Task 1 orthomosaic
EXPORT_ORTHO=true
ORTHO_OUT_DIR_KEY=ortho
ORTHO_EPSG=4326
ORTHO_FILENAME_TEMPLATE=orthomosaic--{flag}.tif
ORTHO_ASSET_CANDIDATES=orthophoto.tif

# Task 2 DEM
EXPORT_DEM=true
EXPORT_DEM_DOWNLOAD=true
DEM_EPSG=3857
DTM_DIR_KEY=dem_dtm
DSM_DIR_KEY=dem_dsm
DEM_FILENAME_TEMPLATE={color}-{shading}.tif
DEM_MODELS=dtm,dsm
DEM_COLORS=earth,gray,rainbow,slope,terrain
DEM_SHADINGS=none,hillshade,extruded

# Task 2 all assets zip into rgb/odm
EXPORT_ALL_ASSETS_ZIP=true
ALL_ASSETS_OUT_DIR_KEY=odm
ALL_ASSETS_FILENAME_TEMPLATE={survey_id}-RGB-{flag}-all.zip

# Point Cloud
EXPORT_POINTCLOUD=true
POINTCLOUD_REQUIRED=true
POINTCLOUD_OUT_DIR_KEY=3d
# Point cloud web export settings
# Max points kept after downsampling (browser memory safety)
# 1M = mobile/low-end, 3M = default desktop, 5M = high-end
POINTCLOUD_MAX_POINTS=3000000
POINTCLOUD_VIEWPOINT=0 0 0 1 0 0 0
POINTCLOUD_FILENAME_TEMPLATE={survey_id}-RGB-{flag}.ply
POINTCLOUD_ASSET_CANDIDATES=georeferenced_model.laz,odm_georeferencing/odm_georeferenced_model.laz,odm_georeferencing/georeferenced_model.laz

#QGIS
QGIS_ENABLED=true
QGIS_ROOT=C:/Program Files/QGIS 3.40.7
GDALWARP_PATH=C:/Program Files/QGIS 3.40.7/bin/gdalwarp.exe
GDAL2TILES_PATH=C:/Program Files/QGIS 3.40.7/apps/Python312/Scripts/gdal2tiles.py
PDAL_PATH=C:/Program Files/QGIS 3.40.7/bin/pdal.exe
GDALINFO_PATH=C:/Program Files/QGIS 3.40.7/bin/gdalinfo.exe
QGIS_LOCAL_STAGING_ENABLED=true
QGIS_LOCAL_STAGING_DIR=

QGIS_TILES_PROFILE=mercator
QGIS_TILES_ZOOM=11-24
QGIS_TILES_COPYRIGHT=ASIMOV-HAWKS

#Experiments
EXPERIMENT_ENABLED=false
EXPERIMENT_PROFILE=rgb_exp_01
EXPERIMENT_USE_YEAR_SUBDIR=false
EXPERIMENT_CROSSRUN_ENABLED=true
EXPERIMENT_NAMING_MODE=site

#Maps
MAP_EXPORT_ROOT=exports/maps
STADIA_MAPS_API_KEY=81091371-e775-4bd2-81b5-e4bc459887bb
MAP_EXPORT_INSET_DPI=800
MAP_EXPORT_PREVIEW_DPI=300
MAP_EXPORT_PDF_DPI=450